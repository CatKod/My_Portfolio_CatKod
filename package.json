{
  "name": "my-portfolio-catkod-tools",
  "private": true,
  "type": "module",
  "description": "Pipeline dựng và kiểm thử site tĩnh portfolio của Hoàng Kim Vĩnh (CatKod)",
  "scripts": {
    "build": "node tools/build/buildSite.mjs",
    "deploy": "node tools/deploy/deployPages.mjs",
    "bootstrap": "node tools/bootstrap.mjs",
    "serve": "java -jar build/libs/portfolio-kt.jar --port=9310 --root=site",
    "check": "node tools/verify/parityCheck.mjs",
    "check:icons": "node tools/verify/iconmapdiff.mjs",
    "check:refs": "node tools/verify/refcheck.mjs",
    "check:routes": "node tools/verify/checkroutes.mjs",
    "check:cdn": "node tools/verify/checkicons.mjs",
    "check:live": "node tools/verify/liveverify.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
