# ---------------------------------------------------------------------------
# Artifact tạm trong quá trình rebrand / phân tích
#
# Tất cả artifact sinh ra khi dựng/đối chiếu site được gom vào `artifacts/`
# để thư mục gốc repo luôn gọn. Thư mục này KHÔNG commit — chỉ dùng để tra
# cứu trên máy.
#
#   artifacts/flight/     — flight payload gốc (*.flight.raw / *.flight.txt)
#   artifacts/rsc/        — cây RSC đã giải nén (rsc_*.txt)
#   artifacts/text/       — text node trích ra (text_*.txt)
#   artifacts/templates/  — mẫu HTML dùng để vá (tmpl_*.html)
#   artifacts/tmp/        — kết quả so sánh DOM, output tạm (tmp_*)
# ---------------------------------------------------------------------------
artifacts/

# Artifact rơi về gốc repo (script cũ ghi thẳng vào cwd)
*.flight.raw
*.flight.txt
rsc_*.txt
text_*.txt
tmp_*.html
tmp_*.txt
tmp_*.json
tmpl_*.html
gh_catkod.html

# Bản gốc (site của Irfan Sabrian) chỉ dùng làm nguồn cho script rebrand.
# Tải lại bằng: node tools/bootstrap.mjs
site.orig.bak/

# Script điều tra 1-lần trong lúc sửa bug — giữ trên máy để tra cứu,
# không commit lên repo.
tools/scratch/

# Profile trình duyệt dùng cho REA
.chrome-rea/
.chrome-rea2/

# Output của Gradle / công cụ
build/
.gradle/
.kotlin/
shots/

# Output của các script dò trong tools/ (chỉ ở thư mục gốc tools/)
tools/*.txt
tools/*.html
tools/*.json

# Danh sách icon CDN — sinh ra bởi tools/verify/fetchCdnIcons.mjs
tools/data/cdn-icons.txt

# Dependency của script kiểm thử (playwright)
node_modules/

# Bản deploy dựng cho GitHub Pages — sinh ra từ site/ bởi tools/deploy/prepareDeploy.mjs,
# đã được publish sang repo CatKod/CatKod.github.io nên không cần track ở đây.
deploy/

# File so sánh byte-for-byte trước/sau refactor
.refactor-before.sha256

.tmp-before/
.tmp-after/

# Dependency của API bảng tin khách (Vercel tự cài khi build)
guestbook-api/node_modules/
guestbook-api/.vercel/
