# Tải lại bằng: node tools/bootstrap.mjs
site.orig.bak/

# Script điều tra 1-lần trong lúc sửa bug — giữ trên máy để tra cứu,
# không commit lên repo.
tools/scratch/

# Profile trình duyệt dùng cho REA
.chrome-rea/
.chrome-rea2/

# Output của Gradle / công cụ
build/
.gradle/
